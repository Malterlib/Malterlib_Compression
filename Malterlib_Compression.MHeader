%Repository "zlib"
{
	Repository
	{
		Type "External"
		Remotes =+ {Name: "upstream", URL: "https://github.com/madler/zlib.git"}
	}
}

%Repository "miniz"
{
	Repository
	{
		Type "External"
		Remotes =+ {Name: "upstream", URL: "https://github.com/richgel999/miniz.git"}
	}

	Compile
	{
		!!CompileDialect "C"
		Analyzer false
	}
}

%Repository "zstd"
{
	Repository
	{
		Type "External"
		DefaultUpstreamBranch "dev"
		Remotes =+ {Name: "upstream", URL: "https://github.com/facebook/zstd.git"}
	}
}

%Group "{Malterlib}/{Lib_libzstd_libzstd_static}/{TargetInjection}"
{
	!DocumentationEnabled true

	Compile
	{
		&
		{
			!DocumentationEnabled true
			CompileDialect "C"
		}

		SearchPath += "../../External/zstd/lib"->MakeAbsolute()
	}
}

%Import "../../External/zstd/build/cmake/CMakeLists.txt"
{
	Import.CMake_Variables =+ [
		"ZSTD_BUILD_TESTS=OFF"
		, "ZSTD_BUILD_SHARED=OFF"
	]

	Compile
	{
		!!CompileDialect "C"

		Analyzer false
		Warnings_UnusedFunction false
		{
			!!Compiler "Clang"
		}

		PreprocessorDefines += "_GNU_SOURCE=1"
		{
			!!PlatformFamily "Linux"
		}
	}

	%Target "Lib_libzstd_libzstd_static"
	{
		Target
		{
			DependencyInjectionGroups =+ "{Malterlib}/{Lib_libzstd_libzstd_static}/{TargetInjection}"
		}

		%Group "opt"
		{
			%Group "lib"
			{
				%Group "decompress"
				{
					%File `@('../..'->MakeAbsolute())/External/zstd/lib/decompress/huf_decompress_amd64.S`
					{
						&
						{
							Architecture "x64"
							!PlatformFamily "Windows"
						}

						Compile.Type "Assembler"
						{
							&
							{
								Architecture "x64"
								!PlatformFamily "Windows"
							}
						}
					}
				}
			}
		}
	}
}

Compile.SearchPath += "../../External/zlib"->MakeAbsolute()
{
	!!CompileDialect "C"
}

Import "../../External/zlib/zlib.MTarget"
Import "../Core/Lib_Malterlib.MTarget"
Import "LibArchive/Malterlib_Compression_LibArchive.MHeader"

%Group "{Malterlib}/{Lib_Malterlib_Compression}"
{
	%Group "Compression"
	{
		%Group "Include"
		{
			Compile.Type "C++"
			{
				!!DocumentationEnabled true
			}
			%File "Include/Mib/Compression/^*"
		}
		%File "Source/*"
		%Group "Documentation"
		{
			%File "Documentation/*"
		}
	}
	%Dependency "Lib_zlib"
	{
		!DocumentationEnabled true

		Dependency.Indirect true
	}
}

Property
{
	MalterlibLibrary_Compression: bool = MalterlibLibrary_All
	MalterlibSubLibraries =+ "Compression"
	{
		!!MalterlibLibrary_Compression true
	}
//	MalterlibSubLibrarySeparate_Lib_Malterlib_Compression: bool = true
	MalterlibIncludeRoots =+ "Include"->MakeAbsolute()
	{
		!!MalterlibLibrary_Compression true
	}
}

Property
{
	!!MalterlibEnableInternalTests true

	MalterlibTests =+ "Malterlib_Compression"
	MalterlibTestFiles_Malterlib_Compression: [type(CEntity)] = ["Test/*"->MakeAbsolute()]
}

