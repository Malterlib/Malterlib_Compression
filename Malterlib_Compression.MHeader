%Repository "zlib"
{
	Repository
	{
		Type External
		Remotes "upstream=https://github.com/madler/zlib.git;@(Repository.Remotes)"
	}
}

%Repository "miniz"
{
	Repository
	{
		Type External
		Remotes "upstream=https://github.com/richgel999/miniz.git;@(Repository.Remotes)"
	}
}

Compile.SearchPath "@('../../External/zlib'->MakeAbsolute());@(Compile.SearchPath)"
{
	!!CompileDialect C
}

Import "../../External/zlib/zlib.MTarget"

Import "../Core/Lib_Malterlib.MTarget"

%Group "{Malterlib}/{Lib_Malterlib_Compression}"
{
	%Group Compression
	{
		%Group Include
		{
			Compile.Type "C++"
			{
				!!DocumentationEnabled true
			}
			%File "Include/Mib/Compression/^*"
		}
		%File "Source/*"
		%Group Documentation
		{
			%File "Documentation/*"
		}
	}
	%Dependency "Lib_zlib"
	{
		!DocumentationEnabled true

		Dependency.Indirect true
	}
}

Property
{
	MalterlibLibrary_Compression true
	{
		&
		{
			MalterlibLibrary_Compression ""
			MalterlibLibrary_All true
		}
	}
	MalterlibSubLibraries "Compression;@(MalterlibSubLibraries)"
	{
		!!MalterlibLibrary_Compression true
	}
//	MalterlibSubLibrarySeparate_Lib_Malterlib_Compression true
	MalterlibIncludeRoots "@('Include'->MakeAbsolute());@(MalterlibIncludeRoots)"
	{
		!!MalterlibLibrary_Compression true
	}
}

Property
{
	!!MalterlibEnableInternalTests true
	
	MalterlibTests "Malterlib_Compression;@(MalterlibTests)"
	MalterlibTestFiles_Malterlib_Compression "@('Test/*'->MakeAbsolute())"
}

