Property.CMakeOutputPath_libzstd: string = `@('..'->MakeAbsolute())`->MakeAbsolute()
%Target "Lib_libzstd_libzstd_static"
{
	Compile
	{
		!!Compile.Type "C"
		SearchPath += [
			`@('..'->MakeAbsolute())/lib`->MakeAbsolute(),
			`@(CMakeIntermediateDirectory)/External_zstd_build_cmake`->MakeAbsolute(),
			`@('../../../../../External/zstd/build/cmake'->MakeAbsolute())/lib`->MakeAbsolute(),
			`@('../../../../..'->MakeAbsolute())/External/zstd/lib`->MakeAbsolute(),
			`@('../../../../..'->MakeAbsolute())/External/zstd/lib/common`->MakeAbsolute()
		]
		PreprocessorDefines += [
			"XXH_NAMESPACE=ZSTD_",
			"ZSTD_LEGACY_SUPPORT=0",
			"ZSTD_MULTITHREAD"
		]
	}
	Property.MalterlibTargetNameType "Normal"
	Compile.AllowNonExisting true
	Target.Group "External/libzstd"
	{
		!!Target.Group undefined
	}
	Target.Type "StaticLibrary"
	Target.BaseName "libzstd_libzstd_static"
	Target.BaseFileName "libzstd_static"
	%Group "opt"
	{
		%Group "lib"
		{
			%Group "common"
			{
				%File `@('../../../../..'->MakeAbsolute())/External/zstd/lib/common/debug.c`
				{
					Compile.Type "C"
				}
