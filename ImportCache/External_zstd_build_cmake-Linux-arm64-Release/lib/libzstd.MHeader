			%Group "decompress"
			{
				%File `@('../../../../..'->MakeAbsolute())/External/zstd/lib/decompress/huf_decompress.c`
				{
					Compile.Type "C"
				}
				%File `@('../../../../..'->MakeAbsolute())/External/zstd/lib/decompress/zstd_ddict.c`
