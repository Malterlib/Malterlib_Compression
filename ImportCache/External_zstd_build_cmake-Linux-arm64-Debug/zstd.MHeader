%Target "Tool_libzstd_uninstall"
{
	Property.MalterlibTargetNameType "Normal"
	Compile.AllowNonExisting true
	Compile.Disabled true
	Target.Group "External/libzstd"
	{
		!!Target.Group undefined
	}
	Target.Type "Tool"
	Target.BaseName "libzstd_uninstall"
	Target.BaseFileName "uninstall"
	%Group "Linux"
	{
		%Group "arm64"
		{
			%Group `@(FullConfiguration)`
			{
				%Group "lib"
				{
					%Group "CMakeFiles"
					{
						%File `@('.'->MakeAbsolute())/lib/CMakeFiles/uninstall.rule`
						{
							Compile
							{
								Type "Custom"
								Custom_CommandLine `MToolCMake -P @(`@('.'->MakeAbsolute())/lib/cmake_uninstall.cmake`->MakeAbsolute()->EscapeHost())`
								AllowNonExisting true
								Disabled false
								Custom_WorkingDirectory `@('.'->MakeAbsolute())/lib`->MakeAbsolute()
								Custom_Outputs []
								Custom_Inputs []
							}
						}
					}
				}
			}
		}
	}
}
%Target "Com_programs_zstd"
