Property.CMakeOutputPath_programs: string = `@('..'->MakeAbsolute())`->MakeAbsolute()
%Target "Com_programs_zstd"
{
	Compile
	{
		!!Compile.Type "C"
		SearchPath += [
			`@('..'->MakeAbsolute())/programs`->MakeAbsolute(),
			`@(CMakeIntermediateDirectory)/External_zstd_build_cmake`->MakeAbsolute(),
			`@('../../../../../External/zstd/build/cmake'->MakeAbsolute())/programs`->MakeAbsolute(),
			`@('../../../../..'->MakeAbsolute())/External/zstd/programs`->MakeAbsolute(),
			`@('../../../../..'->MakeAbsolute())/External/zstd/lib`->MakeAbsolute(),
			`@('../../../../..'->MakeAbsolute())/External/zstd/lib/common`->MakeAbsolute(),
			`@('../../../../..'->MakeAbsolute())/External/zstd/lib/compress`->MakeAbsolute(),
			`@('../../../../..'->MakeAbsolute())/External/zstd/lib/dictBuilder`->MakeAbsolute()
		]
		PreprocessorDefines += [
			"XXH_NAMESPACE=ZSTD_",
			"ZSTD_LEGACY_SUPPORT=0",
			"ZSTD_MULTITHREAD"
		]
	}
	Property.MalterlibTargetNameType "Normal"
	Compile.AllowNonExisting true
	Target.Group "External/programs"
	{
		!!Target.Group undefined
	}
	Target.Type "ConsoleExecutable"
	Target.BaseName "programs_zstd"
	Target.BaseFileName "zstd"
	%Group "opt"
	{
		%Group "programs"
		{
			%File `@('../../../../..'->MakeAbsolute())/External/zstd/programs/zstdcli.c`
			{
				Compile.Type "C"
			}
			%File `@('../../../../..'->MakeAbsolute())/External/zstd/programs/util.c`
			{
				Compile.Type "C"
			}
			%File `@('../../../../..'->MakeAbsolute())/External/zstd/programs/timefn.c`
			{
				Compile.Type "C"
			}
			%File `@('../../../../..'->MakeAbsolute())/External/zstd/programs/fileio.c`
			{
				Compile.Type "C"
			}
			%File `@('../../../../..'->MakeAbsolute())/External/zstd/programs/benchfn.c`
			{
				Compile.Type "C"
			}
			%File `@('../../../../..'->MakeAbsolute())/External/zstd/programs/benchzstd.c`
			{
				Compile.Type "C"
			}
			%File `@('../../../../..'->MakeAbsolute())/External/zstd/programs/datagen.c`
			{
				Compile.Type "C"
			}
			%File `@('../../../../..'->MakeAbsolute())/External/zstd/programs/dibio.c`
			{
				Compile.Type "C"
			}
			%File `@('../../../../..'->MakeAbsolute())/External/zstd/programs/zstdcli_trace.c`
			{
				Compile.Type "C"
			}
		}
	}
	%Dependency "Lib_libzstd_libzstd_static"
}
%Target "Tool_programs_zstdcat"
{
	Property.MalterlibTargetNameType "Normal"
	Compile.AllowNonExisting true
	Compile.Disabled true
	Target.Group "External/programs"
	{
		!!Target.Group undefined
	}
	Target.Type "Tool"
	Target.BaseName "programs_zstdcat"
	Target.BaseFileName "zstdcat"
	%Group "macOS"
	{
		%Group "arm64e"
		{
			%Group `@(FullConfiguration)`
			{
				%Group "programs"
				{
					%Group "CMakeFiles"
					{
						%File `@('..'->MakeAbsolute())/programs/CMakeFiles/zstdcat.rule`
						{
							Compile
							{
								Custom_CommandLine `MToolCMake -E create_symlink zstd zstdcat`
								AllowNonExisting true
								Disabled false
								Custom_WorkingDirectory `@('..'->MakeAbsolute())/programs`->MakeAbsolute()
								Custom_Outputs []
								Custom_Inputs [
									`@('..'->MakeAbsolute())/programs/zstd`->MakeAbsolute()
								]
							}
						}
					}
				}
			}
		}
	}
	%Dependency "Com_programs_zstd"
	{
		Dependency.Link false
	}
}
