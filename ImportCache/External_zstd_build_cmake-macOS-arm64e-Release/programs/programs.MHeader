%Target "Tool_programs_zstd.1"
{
	Property.MalterlibTargetNameType "Normal"
	Compile.AllowNonExisting true
	Compile.Disabled true
	Target.Group "External/programs"
	{
		!!Target.Group undefined
	}
	Target.Type "Tool"
	Target.BaseName "programs_zstd.1"
	Target.BaseFileName "zstd.1"
	%Group "macOS"
	{
		%Group "arm64e"
		{
			%Group `@(FullConfiguration)`
			{
				%Group "programs"
				{
					%Group "CMakeFiles"
					{
						%File `@('..'->MakeAbsolute())/programs/CMakeFiles/zstd.1.rule`
						{
							Compile
							{
								Custom_CommandLine `MToolCMake -E copy @(`@('../../../../../External/zstd/build/cmake'->MakeAbsolute())/../../programs/zstd.1`->MakeAbsolute()->EscapeHost()) .`
								AllowNonExisting true
								Disabled false
								Custom_WorkingDirectory `@('..'->MakeAbsolute())/programs`->MakeAbsolute()
								Custom_Outputs []
								Custom_Inputs []
							}
						}
					}
				}
			}
		}
	}
}
