%Repository "libarchive"
{
	Repository
	{
		Type "External"
		Remotes =+ {Name: "upstream", URL: "https://github.com/libarchive/libarchive.git"}
		{
			!!MalterlibAddUpstreams true
		}
	}
}

%Import "../../../External/libarchive/CMakeLists.txt"
{
	Property
	{
		!!PlatformFamily "Windows"

		MalterlibWindowsNtVersion "_WIN32_WINNT_WIN7"
		MalterlibWindowsVersion "NTDDI_WIN7"
	}

	Import.CMake_FullRebuildVersion `@(Import.CMake_FullRebuildVersion).1`
	Import.CMake_Variables =+ [
		"ENABLE_TAR=1"
		, "ENABLE_TAR_SHARED=0"
		, "ENABLE_CPIO=0"
		, "ENABLE_CAT=0"
		, "ENABLE_CAT_SHARED=0"
		, "ENABLE_TEST=0"
		, "ENABLE_COVERAGE=0"
		, "ENABLE_INSTALL=0"
		, "ENABLE_ICONV=0"
		, "ENABLE_LZ4=0"
		, "ENABLE_ZSTD=1"
		, "ENABLE_OPENSSL=1"
		, "ENABLE_NETTLE=0"
		, "ENABLE_LIBXML2=0"
		, "ENABLE_LZMA=0"
		, "ENABLE_BZip2=0"
		, "ENABLE_EXPAT=0"
		, "ENABLE_LIBB2=0"

	]

	Import.CMake_Variables =+ [
		"HAVE_ZLIB_H=1"
		, "ARCHIVE_CRYPTO_MD5_OPENSSL=1"
		, "ARCHIVE_CRYPTO_RMD160_OPENSSL=1"
		, "ARCHIVE_CRYPTO_SHA1_OPENSSL=1"
		, "ARCHIVE_CRYPTO_SHA256_OPENSSL=1"
		, "ARCHIVE_CRYPTO_SHA384_OPENSSL=1"
		, "ARCHIVE_CRYPTO_SHA512_OPENSSL=1"
	]

	Import.CMake_Variables =+ [
		`ZSTD_INCLUDE_DIR=@("../../../External/zstd/lib"->MakeAbsolute())`
		, `ZSTD_LIBRARY=@(Malterlib_DummmyLibrary)`
		, "HAVE_LIBZSTD=1"
		, "HAVE_ZSTD_compressStream=1"
	]

	Import.CMake_Variables =+ "HAVE_LZMA_STREAM_ENCODER_MT=0"
	{
		!!PlatformFamily "macOS"
	}

	Import.CMake_Variables =+ "CMAKE_BUILD_WITH_INSTALL_RPATH=ON"
	{
		&
		{
			PlatformFamily "Linux"
		}
	}

	Compile
	{
		!!MalterlibCompileSupportTabSetings true
		IndentWidth 4
		TabWidth 4
		UsesTabs true
	}
	Compile
	{
		!!CompileDialect "C"
		PrefixHeader undefined

		Analyzer false

		Warnings "Off"
		{
			!!PlatformFamily "Windows"
		}
		Warnings_UnusedButSetVariable false
		{
			!!Compiler "Clang"
		}
		Warnings_SingleBitBitfieldConstantConversion false
		{
			!!Compiler "Clang"
		}
	}

	%Target "Lib_libarchive_archive_static"
	{
		Target.ExtraGroups =+ "{Malterlib}/{Lib_Malterlib_Cryptography}/{DependOnBoringSSL}"
		%Dependency "xmllite.lib"
		{
			!!PlatformFamily "Windows"

			Dependency
			{
				Type "Library"
				Indirect true
			}
		}
		%Dependency "acl"
		{
			!!PlatformFamily "Linux"

			Dependency
			{
				Type "Library"
				Indirect true
			}
		}
	}

	%Target "Com_libarchive_bsdtar"
	{
		Property.ProductName "BSD Tar"
		%Group "Source"
		{
			%File "Source/AllowInvalidExit.cpp"
			{
				!!PlatformFamily "Windows"
			}
		}
		%Dependency "Lib_Malterlib"
		%Dependency "Lib_zlib"
		%Dependency "Lib_libzstd_libzstd_static"
	}
}
